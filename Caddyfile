https://saee:443, https://100.88.222.48:443 {
    tls /etc/ssl/server.crt /etc/ssl/server.key

    encode gzip zstd

    # 1. Route backend traffic first
    handle /api* {
        reverse_proxy backend:3000
    }

    handle /ws* {
        reverse_proxy backend:3000
    }

    handle /audio* {
        reverse_proxy backend:3000
    }

    handle /ping* {
        reverse_proxy backend:3000
    }

    # 2. Everything else is frontend SPA
    handle {
        root * /srv/dist
        try_files {path} /index.html
        file_server
    }
}