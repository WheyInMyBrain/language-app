:80 {
    encode gzip zstd

    # Route API, WebSockets, Audio, and Ping to backend container
    @backend_traffic {
        path /api*
        path /ws*
        path /audio*
        path /ping*
    }
    reverse_proxy @backend_traffic backend:3000

    # Everything else is frontend SPA
    root * /srv/dist
    file_server
    try_files {path} /index.html
}